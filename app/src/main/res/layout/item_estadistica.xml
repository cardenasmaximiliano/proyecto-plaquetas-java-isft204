<?xml version="1.0" encoding="utf-8"?>
<!-- Una fila de las estadísticas: etiqueta a la izquierda y valor a la derecha. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/espacio_chico"
    android:background="@drawable/bg_tarjeta"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/espacio_medio">

    <TextView
        android:id="@+id/textoEtiqueta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <TextView
        android:id="@+id/textoValor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/hemo_primario"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
