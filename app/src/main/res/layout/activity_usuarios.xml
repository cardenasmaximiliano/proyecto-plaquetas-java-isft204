<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/margen_pantalla">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonVolverUsuarios"
            style="@style/Widget.HemoGestion.Button.Secundario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/espacio_medio"
            android:text="@string/volver_al_inicio" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/modulo_usuarios"
            android:textAppearance="?attr/textAppearanceHeadlineMedium" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_chico"
            android:layout_marginBottom="@dimen/espacio_grande"
            android:text="@string/usuarios_explicacion"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <!-- Alta: SuperAdmin y Director -->
        <LinearLayout
            android:id="@+id/tileNuevoUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/espacio_medio"
            android:background="@drawable/bg_tarjeta"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="72dp"
            android:orientation="horizontal"
            android:padding="@dimen/espacio_grande">

            <ImageView
                style="@style/Widget.HemoGestion.TileIcono"
                android:layout_marginBottom="0dp"
                android:layout_marginEnd="@dimen/espacio_medio"
                android:contentDescription="@null"
                android:src="@drawable/ic_modulo_usuarios" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/usuarios_nuevo"
                android:textAppearance="?attr/textAppearanceTitleMedium" />
        </LinearLayout>

        <!-- Lista y administración de cuentas: solo SuperAdmin -->
        <LinearLayout
            android:id="@+id/tileVerUsuarios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tarjeta"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="72dp"
            android:orientation="horizontal"
            android:padding="@dimen/espacio_grande"
            android:visibility="gone">

            <ImageView
                style="@style/Widget.HemoGestion.TileIcono"
                android:layout_marginBottom="0dp"
                android:layout_marginEnd="@dimen/espacio_medio"
                android:contentDescription="@null"
                android:src="@drawable/ic_modulo_donantes" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/usuarios_ver"
                android:textAppearance="?attr/textAppearanceTitleMedium" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
