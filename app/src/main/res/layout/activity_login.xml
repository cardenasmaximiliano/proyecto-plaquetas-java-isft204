<?xml version="1.0" encoding="utf-8"?>
<!-- Ingreso: fondo verde degradado, logo centrado, campos con línea blanca y botón blanco. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/margen_pantalla"
        android:paddingTop="48dp"
        android:paddingEnd="@dimen/margen_pantalla"
        android:paddingBottom="@dimen/margen_pantalla">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginBottom="@dimen/espacio_chico"
            android:contentDescription="@null"
            android:src="@drawable/ic_logo_hemo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/espacio_grande"
            android:text="@string/app_name"
            android:textColor="@color/hemo_texto_sobre_primario"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/espacio_medio"
            android:text="@string/login_titulo"
            android:textColor="@color/hemo_texto_sobre_primario"
            android:textSize="14sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/espacio_medio"
            android:textColorHint="@color/hemo_texto_sobre_primario"
            app:boxBackgroundMode="none"
            app:boxStrokeColor="@color/hemo_texto_sobre_primario"
            app:hintTextColor="@color/hemo_texto_sobre_primario"
            android:hint="@string/login_usuario">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/hemo_texto_sobre_primario" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/espacio_medio"
            android:hint="@string/login_password"
            android:textColorHint="@color/hemo_texto_sobre_primario"
            app:boxBackgroundMode="none"
            app:boxStrokeColor="@color/hemo_texto_sobre_primario"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/hemo_texto_sobre_primario"
            app:hintTextColor="@color/hemo_texto_sobre_primario">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:maxLines="1"
                android:textColor="@color/hemo_texto_sobre_primario" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/mensaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/espacio_medio"
            android:textColor="@color/hemo_texto_sobre_primario"
            android:textStyle="bold"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonIngresar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_grande"
            android:backgroundTint="@color/hemo_texto_sobre_primario"
            android:text="@string/login_boton"
            android:textColor="@color/hemo_primario_oscuro"
            app:cornerRadius="28dp" />

    </LinearLayout>
</ScrollView>
