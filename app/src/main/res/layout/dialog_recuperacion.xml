<?xml version="1.0" encoding="utf-8"?>
<!-- Editar el tiempo de recuperación de una donación. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/margen_pantalla">

    <TextView
        android:id="@+id/textoActual"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <CheckBox
        android:id="@+id/checkQuitarAjuste"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_chico"
        android:text="@string/recuperacion_quitar" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/botonPuedeDonarDesde"
        style="@style/Widget.HemoGestion.Button.Secundario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_chico" />

    <com.google.android.material.textfield.TextInputLayout
        style="?attr/textInputStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_chico"
        android:hint="@string/motivo_obligatorio">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputMotivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
