<?xml version="1.0" encoding="utf-8"?>
<!-- Un turno de la agenda. El estado se pinta con uno de los bg_chip_* (ver AgendaActivity). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/espacio_medio"
    android:background="@drawable/bg_tarjeta"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/espacio_grande">

    <TextView
        android:id="@+id/textoHora"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/espacio_medio"
        android:background="@drawable/bg_chip_neutro"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:textAppearance="?attr/textAppearanceTitleMedium" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textoDonante"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <TextView
            android:id="@+id/textoTipo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/hemo_primario"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/textoEstado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chip_neutro"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
