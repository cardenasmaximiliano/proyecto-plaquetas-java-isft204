<?xml version="1.0" encoding="utf-8"?>
<!-- Barra de navegación de abajo. Se incluye en las pantallas principales y la resalta BarraInferior.java. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/hemo_superficie"
    android:elevation="8dp"
    android:orientation="horizontal"
    android:padding="6dp">

    <LinearLayout
        android:id="@+id/navInicio"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="2dp"
        android:layout_weight="1"
        android:background="@drawable/bg_nav_item"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp">

        <ImageView
            android:id="@+id/navIconoInicio"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/nav_inicio"
            android:src="@drawable/ic_nav_inicio" />

        <TextView
            android:id="@+id/navTextoInicio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/nav_inicio"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navAgenda"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="2dp"
        android:layout_weight="1"
        android:background="@drawable/bg_nav_item"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp">

        <ImageView
            android:id="@+id/navIconoAgenda"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/nav_agenda"
            android:src="@drawable/ic_nav_agenda" />

        <TextView
            android:id="@+id/navTextoAgenda"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/nav_agenda"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navBusqueda"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="2dp"
        android:layout_weight="1"
        android:background="@drawable/bg_nav_item"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp">

        <ImageView
            android:id="@+id/navIconoBusqueda"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/nav_busqueda"
            android:src="@drawable/ic_nav_busqueda" />

        <TextView
            android:id="@+id/navTextoBusqueda"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/nav_busqueda"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navEstadisticas"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="2dp"
        android:layout_weight="1"
        android:background="@drawable/bg_nav_item"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp">

        <ImageView
            android:id="@+id/navIconoEstadisticas"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/nav_estadisticas"
            android:src="@drawable/ic_nav_estadisticas" />

        <TextView
            android:id="@+id/navTextoEstadisticas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/nav_estadisticas"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
