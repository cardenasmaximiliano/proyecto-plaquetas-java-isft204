<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="vertical"
    android:padding="@dimen/margen_pantalla">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/botonVolver"
        style="@style/Widget.HemoGestion.Button.Secundario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/espacio_medio"
        android:text="@string/volver" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/espacio_medio"
        android:text="@string/donantes_titulo"
        android:textAppearance="?attr/textAppearanceHeadlineMedium" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/botonNuevo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/espacio_medio"
        android:text="@string/donantes_nuevo" />

    <com.google.android.material.textfield.TextInputLayout
        style="?attr/textInputStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/donantes_buscar">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputBuscar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/textoCantidad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/espacio_chico"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/listaDonantes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/botonCargarMas"
        style="@style/Widget.HemoGestion.Button.Secundario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_chico"
        android:text="@string/donantes_cargar_mas"
        android:visibility="gone" />

</LinearLayout>

    <include layout="@layout/view_barra_inferior" />
</LinearLayout>
