<?xml version="1.0" encoding="utf-8"?>
<!-- La API corre en la PC (HTTP local, sin TLS). Solo se permite HTTP en las direcciones locales. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>     <!-- emulador: la PC -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
    <!-- Celular físico en la WiFi del centro: agregar aquí la IP de la PC (ver GUIA-ANDROID.md). -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.0.10</domain>
    </domain-config>
</network-security-config>
